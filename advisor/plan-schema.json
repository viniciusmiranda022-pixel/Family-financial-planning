{
  "$comment": "Output contract for POST /v1/plan (WA-02, issue #74, docs/WORK_ORDER_WA_02.md). Same structural boundary as interpret-schema.json/audit-schema.json: there is no field here that could authorize a mutation, run SQL, or reference an id the model was never given -- `steps[].tool` is a closed enum of generic, already-existing Family Finance tools, and `steps[].arguments` is a flat string-only bag the deterministic backend (app.services.assistant_tools) re-validates per tool, re-resolves against real household data, and may still reject or ask for clarification even when this schema accepts it. The model plans which tools to call and with which free-text hints; it never computes a financial total and never receives one back to recompute -- see app.services.assistant_orchestrator for the full re-validation/execution boundary. `additionalProperties: false` throughout means an attempt to smuggle an authority-shaped field (e.g. `account_id`, `amount`, `sql`, `confirmed`) is a schema violation, not a warning.",
  "type": "object",
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "needs_clarification": { "type": "boolean" },
    "clarifying_question": { "type": ["string", "null"], "maxLength": 300 },
    "steps": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "properties": {
          "tool": {
            "type": "string",
            "enum": [
              "query_facts",
              "aggregate_spending",
              "compare_periods",
              "project_horizon",
              "project_category_pace",
              "draft_typed_action",
              "confirm_typed_action",
              "undo_typed_action",
              "cancel_typed_action",
              "financial_aggregate",
              "get_income",
              "get_expenses",
              "get_commitments",
              "get_installments",
              "search_transactions"
            ]
          },
          "arguments": {
            "type": "object",
            "properties": {
              "topic": {
                "type": "string",
                "enum": ["saldo", "gasto_mes", "fatura", "obrigacoes"]
              },
              "dimension": {
                "type": "string",
                "enum": ["categoria", "conta", "cartao", "mes", "titular"]
              },
              "period_text": { "type": "string", "maxLength": 60 },
              "period_a_text": { "type": "string", "maxLength": 60 },
              "period_b_text": { "type": "string", "maxLength": 60 },
              "horizon_days": {
                "type": "string",
                "enum": ["30", "60", "90"]
              },
              "reference_text": { "type": "string", "maxLength": 300 },
              "metric": {
                "type": "string",
                "enum": [
                  "total",
                  "media",
                  "contagem",
                  "minimo",
                  "maximo",
                  "participacao",
                  "variacao_absoluta",
                  "variacao_percentual"
                ]
              },
              "compare_period_text": { "type": "string", "maxLength": 60 },
              "category_hint": { "type": "string", "maxLength": 200 },
              "exclude_category_hint": { "type": "string", "maxLength": 200 },
              "account_hint": { "type": "string", "maxLength": 200 },
              "holder_hint": { "type": "string", "maxLength": 100 },
              "merchant_hint": { "type": "string", "maxLength": 200 },
              "type_hint": {
                "type": "string",
                "enum": ["renda", "despesa", "transferencia", "estorno", "conciliacao"]
              },
              "status_hint": {
                "type": "string",
                "enum": ["realizado", "comprometido"]
              },
              "top_n": { "type": "string", "maxLength": 3 }
            },
            "additionalProperties": false
          }
        },
        "required": ["tool", "arguments"],
        "additionalProperties": false
      }
    }
  },
  "required": ["schema_version", "needs_clarification", "clarifying_question", "steps"],
  "additionalProperties": false
}
