APP_NAME=Planejamento Financeiro Familiar
ENVIRONMENT=production
POSTGRES_DB=family_finance
POSTGRES_USER=family
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
DATABASE_URL=postgresql+psycopg://family:CHANGE_ME_POSTGRES_PASSWORD@db:5432/family_finance
SECRET_KEY=CHANGE_ME_APPLICATION_SECRET
FILE_ENCRYPTION_KEY=CHANGE_ME_FERNET_KEY
DATA_DIR=/data
COOKIE_SECURE=false
SESSION_HOURS=12
MAX_UPLOAD_MB=25
DEFAULT_TIMEZONE=America/Sao_Paulo
APP_PORT=8080
BACKUP_RETENTION_DAYS=30
