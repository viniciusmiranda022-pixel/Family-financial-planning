APP_NAME=Planejamento Financeiro Familiar
ENVIRONMENT=production
POSTGRES_DB=family_finance
POSTGRES_USER=family
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
DATABASE_URL=postgresql+psycopg://family:CHANGE_ME_POSTGRES_PASSWORD@db:5432/family_finance
SECRET_KEY=CHANGE_ME_APPLICATION_SECRET
FILE_ENCRYPTION_KEY=CHANGE_ME_FERNET_KEY
# Fase 4 (docs/WORK_ORDER_LOCAL_MFA_TOTP.md): exclusive to encrypting the
# TOTP secret at rest -- must be a distinct Fernet key, never the same
# value as FILE_ENCRYPTION_KEY or SECRET_KEY. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MFA_ENCRYPTION_KEY=CHANGE_ME_MFA_FERNET_KEY
DATA_DIR=/data
COOKIE_SECURE=false
SESSION_HOURS=12
MAX_UPLOAD_MB=25
MAX_BATCH_FILES=20
MAX_BATCH_TOTAL_MB=200
DEFAULT_TIMEZONE=America/Sao_Paulo
APP_PORT=8080
BACKUP_RETENTION_DAYS=30
WHISPER_MODEL=tiny
WHISPER_LANGUAGE=pt
ADVISOR_ENABLED=true
ADVISOR_URL=http://advisor:8081
ADVISOR_SHARED_SECRET=CHANGE_ME_ADVISOR_SECRET
ADVISOR_TIMEOUT_SECONDS=75
INTEGRITY_UI_ENABLED=false
CODEX_MODEL=
CODEX_TIMEOUT_MS=70000
# MAIL-01 (docs/WORK_ORDER_DUE_DATE_EMAIL_ALERTS.md): due-date e-mail
# alerts SMTP sender fallback. Leave ALERT_EMAIL_ENABLED=false (or the
# credential vars empty) to keep alert sending off. Since MAIL-04
# (docs/WORK_ORDER_MAIL_04_UI_SMTP_CONFIG.md) an admin can instead
# configure the sender from Configurações -- an enabled, complete
# database config takes precedence over these vars; they remain the
# fallback for an installation that never uses the Settings UI panel.
# Generate a Gmail "App Password" (requires 2-Step Verification on the
# sending account) at https://myaccount.google.com/apppasswords -- never
# use the account's normal login password here.
ALERT_EMAIL_ENABLED=false
ALERT_SMTP_HOST=smtp.gmail.com
ALERT_SMTP_PORT=587
ALERT_SMTP_USERNAME=
ALERT_SMTP_APP_PASSWORD=CHANGE_ME_GMAIL_APP_PASSWORD
ALERT_EMAIL_FROM=
ALERT_EMAIL_USE_STARTTLS=true
ALERT_EMAIL_TIMEOUT_SECONDS=15
ALERT_TEST_EMAIL_MIN_INTERVAL_SECONDS=60
# MAIL-04 (docs/WORK_ORDER_MAIL_04_UI_SMTP_CONFIG.md, issue #110): a
# dedicated Fernet key, exclusive to encrypting the SMTP App Password
# saved through Configurações -- never the same value as SECRET_KEY,
# FILE_ENCRYPTION_KEY, MFA_ENCRYPTION_KEY, or WHATSAPP_PHONE_ENCRYPTION_KEY.
# Optional: leave empty to keep this installation exactly as before
# (env-only ALERT_SMTP_* above) -- the Settings UI SMTP panel stays
# unusable (save/enable fails with a clear error) until this is set.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SMTP_ENCRYPTION_KEY=
# MAIL-02 (docs/WORK_ORDER_DUE_DATE_EMAIL_ALERTS.md): outbox/scheduler
# worker tuning. Safe to leave at these defaults; see
# `app/services/notification_scheduler.py` and `app/cli/notification_worker.py`.
NOTIFICATION_WORKER_POLL_SECONDS=120
NOTIFICATION_DELIVERY_MAX_ATTEMPTS=3
NOTIFICATION_DELIVERY_RETRY_BACKOFF_SECONDS=300
NOTIFICATION_DELIVERY_STALE_AFTER_SECONDS=900
# MAIL-03 (docs/WORK_ORDER_DUE_DATE_EMAIL_ALERTS.md): `docker compose up`
# now also starts a `notification-worker` service (compose.yaml) running
# `python -m app.cli.notification_worker` continuously -- it reuses every
# ALERT_*/NOTIFICATION_* variable above, nothing new to configure here.
# See docs/RUNBOOK_MAIL_ALERTS.md for setup, verifying the worker after a
# restart/reboot, and troubleshooting.
# Issue #85 (docs/WORK_ORDER_PRIVILEGE_DI_CVM.md): CVM daily fund valuation
# worker (`cvm-worker` service, compose.yaml). The source and its
# schema-variance handling are verified -- see "Live-source verification" in
# docs/PRIVILEGE_DI_CVM_INGESTION_INVESTIGATION.md. CVM_VALUATION_ENABLED
# stays false as a deliberate operator opt-in/rollout control, not because
# of an unresolved evidence gap.
CVM_VALUATION_ENABLED=false
CVM_QUOTA_BASE_URL=https://dados.cvm.gov.br/dados/FI/DOC/INF_DIARIO/DADOS
CVM_QUOTA_TIMEOUT_SECONDS=60
CVM_VALUATION_WORKER_POLL_SECONDS=21600
# WA-01 (docs/WORK_ORDER_WA_01.md): WhatsApp webhook gateway
# (`whatsapp-gateway` compose service/profile, `app/whatsapp_gateway_app.py`).
# Stays disabled until real Meta credentials exist -- do not put a real
# Meta app secret, verify token or phone number in this repository. Start
# the `whatsapp-gateway` profile only after all four of these are set.
WHATSAPP_GATEWAY_ENABLED=false
WHATSAPP_APP_SECRET=CHANGE_ME_META_APP_SECRET
WHATSAPP_VERIFY_TOKEN=CHANGE_ME_WEBHOOK_VERIFY_TOKEN
# Fernet key (e.g. `python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`),
# exclusive to hashing/encrypting linked phone numbers at rest -- never
# reuse SECRET_KEY/FILE_ENCRYPTION_KEY/MFA_ENCRYPTION_KEY here.
WHATSAPP_PHONE_ENCRYPTION_KEY=
WHATSAPP_RATE_LIMIT_MAX_PER_WINDOW=30
WHATSAPP_RATE_LIMIT_WINDOW_SECONDS=60
WHATSAPP_GATEWAY_PORT=8091
# WA-03 (docs/WORK_ORDER_WA_03.md): outbound Cloud API credentials used to
# send the Assistant's draft/confirmation replies back to WhatsApp. Distinct
# from the inbound verification credentials above -- do not put a real Meta
# access token or phone number id in this repository.
WHATSAPP_ACCESS_TOKEN=CHANGE_ME_META_ACCESS_TOKEN
WHATSAPP_PHONE_NUMBER_ID=CHANGE_ME_META_PHONE_NUMBER_ID
WHATSAPP_API_BASE_URL=https://graph.facebook.com/v21.0
WHATSAPP_SEND_TIMEOUT_SECONDS=10
# WA-07 (docs/WORK_ORDER_WA_07.md): bounded retry/backoff for transient
# outbound-send/media-fetch failures (network/timeout/5xx only, never
# 4xx/429), the media resource-limit ceiling, and the media-fetch timeout.
# All have safe defaults; only set these if you need to tune them.
WHATSAPP_SEND_MAX_ATTEMPTS=3
WHATSAPP_SEND_BACKOFF_SECONDS=0.2
WHATSAPP_MEDIA_FETCH_MAX_ATTEMPTS=3
WHATSAPP_MEDIA_FETCH_BACKOFF_SECONDS=0.2
WHATSAPP_MEDIA_FETCH_TIMEOUT_SECONDS=20
WHATSAPP_MEDIA_MAX_MB=16
